# Launch v1 primary CTA (all hero / nav / footer / final buttons).
# TidyCal: pick a slot, answer questions, pay $2,000 via PayPal — one flow.
NEXT_PUBLIC_PAY_BOOK_URL=https://tidycal.com/shubhamgupta/ai-workflow-strategy-session

# Aliases
# NEXT_PUBLIC_TIDYCAL_BOOKING_URL=https://tidycal.com/shubhamgupta/ai-workflow-strategy-session
# TIDYCAL_BOOKING_URL=https://tidycal.com/shubhamgupta/ai-workflow-strategy-session

# Later swap: point NEXT_PUBLIC_PAY_BOOK_URL at Stripe Checkout or a payment link.
# NEXT_PUBLIC_STRIPE_CHECKOUT_URL=

# Kit newsletter (footer signup). v4 key from Kit → Settings → Developer.
# Form ID is the numeric id of the Kit form new subscribers join (double opt-in lives on the form).
# KIT_API_KEY=kit_...
# KIT_FORM_ID=

# LinkedIn Insight Tag (Campaign Manager → Measure → Signals → Insight Tag)
# NEXT_PUBLIC_LINKEDIN_PARTNER_ID=10894689

# Google Analytics 4 measurement ID. Falls back to this ID in code when unset.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-4DJJR5N6RE
